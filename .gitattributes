# =============================================================================
# .gitattributes — cross-platform safety for daocubator-visual-novel
# =============================================================================

# Auto-detect text files and normalise line endings to LF in the repo.
# Windows checkouts get CRLF; macOS/Linux get LF.
* text=auto eol=lf

# --- Explicitly text files ---
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.rpy       text eol=lf
*.rpym      text eol=lf

# --- Binary assets — never mangle these ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.svg       binary
*.ico       binary
*.mp4       binary
*.MP4       binary
*.mp3       binary
*.ogg       binary
*.wav       binary
*.flac      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.tar       binary
*.gz        binary

# --- Prebuilt web build: never normalise line endings or mangle bytes ---
web-build/** -text
