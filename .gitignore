# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Ren'Py per-run log in the game dir
/game/log.txt

# Generated Ren'Py web build (regenerate: see WEB.md). Large WASM/data blobs.
/web-build/
# Stray test/log artifacts
/autotest_*.txt
/game/_autotest.rpy
/web-build.zip
/*.zip

# Environment Variables & Secrets
.env
.env.*
*.env
*.key
credentials.json
.env
