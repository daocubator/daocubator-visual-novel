# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Ren'Py per-run log in the game dir
/game/log.txt

# NOTE: /web-build/ is intentionally TRACKED. Cloud Run's push-to-main auto build
# has no Ren'Py SDK, so the Dockerfile serves this prebuilt output.
# Regenerate + commit it with: ./scripts/deploy.sh

# Stray test/log artifacts
/autotest_*.txt
/game/_autotest.rpy
/web-build.zip
/*.zip

# macOS
.DS_Store
prototypes/.DS_Store
game/.DS_Store
vault/.DS_Store

# Environment variables & secrets
.env
.env.*
*.env
*.key
credentials.json
